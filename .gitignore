**/build/

# GrandNode ships source UI assets in a directory named build.
!Ecommerce/src/Web/Grand.SharedUIResources/wwwroot/administration/build/
!Ecommerce/src/Web/Grand.SharedUIResources/wwwroot/administration/build/**

# Machine-local indexes, credentials and generated artifacts
.codegraph/
.local/
.env
.env.*
!.env.example
**/bin/
**/obj/
**/node_modules/
**/.dart_tool/
**/.gradle/
**/Pods/
**/.idea/
**/.vscode/
**/App_Data/appsettings.json
**/App_Data/Development/appsettings.json
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/*service-account*.json
**/*.p8
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.keystore
**/*.jks
**/key.properties
.DS_Store

.playwright-cli/
output/
**/dist/
**/.angular/
**/App_Data/DataProtectionKeys/
**/App_Data/Settings.txt

**/local.properties
**/Generated.xcconfig
**/flutter_export_environment.sh
**/.flutter-plugins*
**/ephemeral/
**/*.mmdb
**/__pycache__/

# MSBuild source files (capital B), not generated mobile build output.
!Ecommerce/src/Build/
!Ecommerce/src/Build/**

# Generated customer exports/uploads never belong in source control.
**/wwwroot/assets/files/exportimport/*
!**/wwwroot/assets/files/exportimport/Index.htm
**/wwwroot/assets/images/uploaded/*
!**/wwwroot/assets/images/uploaded/placeholder.txt

# Runtime settings are never source UI assets.
Ecommerce/src/Web/Grand.SharedUIResources/wwwroot/administration/build/**/appsettings*.json
