**/build

# GrandNode ships source UI assets in a directory named build.
!Ecommerce/src/Web/Grand.SharedUIResources/wwwroot/administration/build/
!Ecommerce/src/Web/Grand.SharedUIResources/wwwroot/administration/build/**

.git
.codegraph
.local
**/.local
**/bin
**/obj

# Plugin binaries are generated separately for each BuildType inside the image.
# Keep source projects in src/Plugins and src/AdminPlugins in the context.
Ecommerce/src/Web/Grand.Web/Plugins/
Ecommerce/src/Web/Grand.Web.MultiTenant/Plugins/
Ecommerce/src/Web/Grand.Web.OnlyAdmin/Plugins/
Ecommerce/src/Installer/Grand.Installer.Cli/Plugins/
Ecommerce/src/Installer/Grand.Data.Uploader/Plugins/
Ecommerce/src/Cli/Grand.BackgroundJobExecuter/Plugins/
**/node_modules
**/.dart_tool
**/.git
**/.env
**/.env.*
**/*.pfx
**/*.p12
**/*.jks
**/*.keystore
**/service-account*.json
**/firebase-admin*.json
**/logs
**/Logs
**/exportimport
# Deployment/runtime secrets must not enter a Docker build context.
**/Settings.cfg
**/DataProtectionKeys
**/App_Data/**/appsettings.json
**/App_Data/**/appsettings.*.json
**/appsettings.Production.json
**/appsettings.Staging.json
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/key.properties
**/local.properties
**/*.pem
**/*.key
**/*.p8
**/service_account*.json
**/*service-account*.json
**/*service_account*.json
**/credentials.json

# Runtime settings are never source UI assets.
Ecommerce/src/Web/Grand.SharedUIResources/wwwroot/administration/build/**/appsettings*.json
