<Project>
  <Import Project="$(MSBuildThisFileDirectory)src/Build/Grand.PluginOutput.props" Condition="'$(_GrandPluginOutputImported)' != 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)src/Build/ManagedTenantPlugins.props" />
  <!-- Runtime configuration and tenant keys are mounted separately from release artifacts. -->
  <Target Name="ExcludePrivateTenantRuntimeFiles" BeforeTargets="CheckForDuplicateItems;AssignTargetPaths">
    <ItemGroup>
      <_PrivateTenantRuntimeFiles Include="App_Data/**/Settings.cfg;App_Data/**/appsettings.json;App_Data/**/appsettings.*.json;App_Data/**/DataProtectionKeys/**/*" />
      <Content Remove="@(_PrivateTenantRuntimeFiles)" />
      <None Remove="@(_PrivateTenantRuntimeFiles)" />
      <EmbeddedResource Remove="@(_PrivateTenantRuntimeFiles)" />
    </ItemGroup>
  </Target>
  <Target Name="ResolveTenantPluginDestination">
    <PropertyGroup>
      <_ManagedBuildType>$(BuildType)</_ManagedBuildType>
      <_TenantPluginDestination>$(TenantPluginRoot)</_TenantPluginDestination>
      <_TenantPublishingHostDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_TenantPublishingHostDirectory>
    </PropertyGroup>
    <Error Condition="'$(_ManagedBuildType)' != 'Frontend' And '$(_ManagedBuildType)' != 'Backend' And '$(_ManagedBuildType)' != 'Installer' And '$(_ManagedBuildType)' != 'Background' And '$(_ManagedBuildType)' != 'Uploader'"
           Text="PublishTenantPlugins requires an explicit BuildType: Frontend, Backend, Installer, Background or Uploader." />
    <Error Condition="'$(_TenantPublishingHostDirectory)' != '$(TenantHostDirectory)'"
           Text="BuildType=$(BuildType) selects $(TenantHostDirectory), but the published project is $(MSBuildProjectFullPath). Choose the matching host and BuildType." />
  </Target>
  <!-- Every standard plugin is built for every target; AdminPlugins are excluded only for Frontend. -->
  <Target Name="BuildManagedTenantPlugins" BeforeTargets="PublishViews;PrepareForPublish"
          DependsOnTargets="ResolveTenantPluginDestination" Condition="'$(PublishTenantPlugins)' == 'true'">
    <ItemGroup>
      <_TenantPluginProject Include="@(ManagedTenantPlugin)"
          Condition="'%(ManagedTenantPlugin.Category)' == 'Plugins' Or '$(_ManagedBuildType)' != 'Frontend'">
        <ProjectPath>$(MSBuildThisFileDirectory)src/%(Category)/%(Identity)/%(Identity).csproj</ProjectPath>
      </_TenantPluginProject>
    </ItemGroup>
    <MakeDir Directories="$(_TenantPluginDestination)" />
    <MSBuild Projects="@(_TenantPluginProject->'%(ProjectPath)')" Targets="Restore;Build" BuildInParallel="false"
             RemoveProperties="PublishDir;TargetFramework;RuntimeIdentifier;SelfContained;OutputPath;OutDir"
             Properties="Configuration=$(Configuration);BuildType=$(_ManagedBuildType);CopyLocalLockFileAssemblies=true;PublishTenantPlugins=false" />
    <!-- Theme views reference frontend types, including when discovered by admin or installer. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)src/Web/Grand.Web/bin/$(Configuration)/net8.0/Grand.Web.dll"
          DestinationFolder="$(_TenantPluginDestination)Theme.Modern/" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CreatePublishedPluginDirectory" AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'Grand.Web' Or '$(MSBuildProjectName)' == 'Grand.Web.MultiTenant' Or '$(MSBuildProjectName)' == 'Grand.Web.OnlyAdmin' Or '$(MSBuildProjectName)' == 'Grand.Installer.Cli'">
    <MakeDir Directories="$(PublishDir)/Plugins;$(PublishDir)/Plugins/bin" />
  </Target>
</Project>
