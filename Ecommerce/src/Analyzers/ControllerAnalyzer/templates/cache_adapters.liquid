import 'package:hive/hive.dart';
import 'package:store_user_app/core/models/network/api_response.dart';

{% for import in Imports %}
import '{{import}}';
{% endfor %}

final cacheAdapterTypes = <void Function(int)>[
{% for endpoint in Endpoints %}
  {% if endpoint.IsApiResponse == true %}
    (int order) => Hive.registerAdapter<{{endpoint.EntityType}}>(CacheAdapter<{{endpoint.EntityType}}>(order)){% if forloop.last == false %},{% endif %}
  {% else %}
    (int order) => Hive.registerAdapter<ApiResponse<{{endpoint.EntityType}}>>(CacheAdapter<ApiResponse<{{endpoint.EntityType}}>>(order)),
    (int order) => Hive.registerAdapter<{{endpoint.EntityType}}>(CacheAdapter<{{endpoint.EntityType}}>(order)),
    (int order) => Hive.registerAdapter<List<{{endpoint.EntityType}}>>(CacheListAdapter<{{endpoint.EntityType}}>(order)){% if forloop.last == false %},{% endif %}
  {% endif %}
{% endfor %}
];