@model SlideModel
<script asp-src="/Plugins/Widgets.Slider/Assets/scripts/linkSelector.js"></script>
<script>
        $(document).ready(function () {
            
            // Handle LinkType changes
            $("#@Html.IdFor(model => model.LinkType)").change(toggleLinkType);
            toggleLinkType();
            
            // Handle selection changes
            $("#@Html.IdFor(model => model.CategoryId)").change(updateReferenceId);
            $("#@Html.IdFor(model => model.ProductId)").change(updateReferenceId);
            $("#@Html.IdFor(model => model.BrandId)").change(updateReferenceId);
            $("#@Html.IdFor(model => model.CollectionId)").change(updateReferenceId);
            $("#@Html.IdFor(model => model.BlogPostId)").change(updateReferenceId);
            $("#@Html.IdFor(model => model.SearchTerm)").change(updateSearchParameters);
        });
        
        function toggleSliderType() {
            var sliderTypeId = $("#@Html.IdFor(model => model.SliderTypeId)").val();
            if (sliderTypeId === @(((int)SliderType.HomePage).ToString())) {
                $('#pnlCategory').hide();
                $('#pnlCollection').hide();
                $('#pnlBrand').hide();
            } else if (sliderTypeId === @(((int)SliderType.Category).ToString())) {
                $('#pnlCategory').show();
                $('#pnlCollection').hide();
                $('#pnlBrand').hide();
            }else if (sliderTypeId === @(((int)SliderType.Collection).ToString())) {
                $('#pnlCategory').hide();
                $('#pnlCollection').show();
                $('#pnlBrand').hide();
            }
            else if (sliderTypeId === @(((int)SliderType.Brand).ToString())) {
                $('#pnlCategory').hide();
                $('#pnlCollection').hide();
                $('#pnlBrand').show();
            }
        }
        
        function toggleLinkType() {
            var linkType = parseInt($("#@Html.IdFor(model => model.LinkType)").val());
            
            // Hide all panels first
            $('#pnlManualLink').hide();
            $('#pnlProduct').hide();
            $('#pnlBlogPost').hide();
            $('#pnlSearchTerm').hide();
            
            // Show relevant panel based on link type
            switch(linkType) {
                case 0: // Manual
                    $('#pnlManualLink').show();
                    break;
                    
                case 1: // Category
                    // Category is already handled by SliderType
                    updateReferenceId();
                    break;
                    
                case 2: // Product
                    $('#pnlProduct').show();
                    updateReferenceId();
                    break;
                    
                case 3: // Brand
                    // Brand is already handled by SliderType
                    updateReferenceId();
                    break;
                    
                case 4: // Collection
                    // Collection is already handled by SliderType
                    updateReferenceId();
                    break;
                    
                case 5: // Blog
                case 6: // BlogList
                    $('#pnlBlogPost').show();
                    updateReferenceId();
                    break;
                    
                case 7: // Search
                    $('#pnlSearchTerm').show();
                    updateSearchParameters();
                    break;
            }
        }
        
        function updateReferenceId() {
            var linkType = parseInt($("#@Html.IdFor(model => model.LinkType)").val());
            var referenceId = "";
            
            switch(linkType) {
                case 1: // Category
                    referenceId = $("#@Html.IdFor(model => model.CategoryId)").val();
                    break;
                    
                case 2: // Product
                    referenceId = $("#@Html.IdFor(model => model.ProductId)").val();
                    break;
                    
                case 3: // Brand
                    referenceId = $("#@Html.IdFor(model => model.BrandId)").val();
                    break;
                    
                case 4: // Collection
                    referenceId = $("#@Html.IdFor(model => model.CollectionId)").val();
                    break;
                    
                case 5: // Blog
                    referenceId = $("#@Html.IdFor(model => model.BlogPostId)").val();
                    break;
                    
                case 6: // BlogList
                    referenceId = ""; // No reference ID needed for blog list
                    break;
            }
            
            $("#ReferenceId").val(referenceId);
        }
        
        function updateSearchParameters() {
            var searchTerm = $("#@Html.IdFor(model => model.SearchTerm)").val();
            
            if (searchTerm) {
                var searchParams = {
                    "q": searchTerm
                };
                
                $("#ReferenceParameters").val(JSON.stringify(searchParams));
            } else {
                $("#ReferenceParameters").val("");
            }
        }
</script>
@{
    Func<int, HelperResult> template = @<div class="form-horizontal">
        <div class="form-body">
            <div class="form-group">
                <admin-label asp-for="@Model.Locales[item].Name"/>
                <div class="col-md-9 col-sm-9">
                    <admin-input asp-for="@Model.Locales[item].Name"/>
                    <span asp-validation-for="@Model.Locales[item].Name"></span>
                </div>
            </div>
            <div class="form-group">
                <admin-label asp-for="@Model.Locales[item].Description"/>
                <div class="col-md-9 col-sm-9">
                    <admin-input asp-for="@Model.Locales[item].Description" asp-template="Editor"/>
                    <span asp-validation-for="@Model.Locales[item].Description"></span>
                </div>
            </div>
            <input type="hidden" asp-for="@Model.Locales[item].LanguageId"/>
        </div>
    </div>;
}
<div class="form-horizontal">
    <localized-editor localized-template="@template" name="slide-info-localized" language-ids="@Model.Locales.Select(c => c.LanguageId).ToList()">
        <div class="form-body">
            <div class="form-group">
                <admin-label asp-for="Name"/>
                <div class="col-md-9 col-sm-9">
                    <admin-input asp-for="Name"/>
                    <span asp-validation-for="Name"></span>
                </div>
            </div>
            <div class="form-group">
                <admin-label asp-for="Description"/>
                <div class="col-md-9 col-sm-9">
                    <admin-input asp-for="Description" asp-template="Editor"/>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
        </div>
    </localized-editor>
    <div class="form-body">
        <div class="form-group">
            <admin-label asp-for="PictureId"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="PictureId"/>
                <span asp-validation-for="PictureId"></span>
            </div>
        </div>
        <!-- Advanced Link Creation Section -->
        <div class="form-group">
            <admin-label asp-for="LinkType"/>
            <div class="col-md-9 col-sm-9">
                <admin-select asp-for="LinkType" asp-items="Html.GetEnumSelectList<SliderLinkType>()"/>
                <span asp-validation-for="LinkType"></span>
            </div>
        </div>

        <!-- Manual URL input -->
        <div class="form-group" id="pnlManualLink">
            <admin-label asp-for="Link"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="Link"/>
                <span asp-validation-for="Link"></span>
                <span class="help-block">Enter a manual URL for the slider</span>
            </div>
        </div>

        <!-- Product selection -->
        <div class="form-group" id="pnlProduct">
            <admin-label asp-for="ProductId"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="ProductId"/>
                <span asp-validation-for="ProductId"></span>
            </div>
        </div>

        <!-- Blog Post selection -->
        <div class="form-group" id="pnlBlogPost">
            <admin-label asp-for="BlogPostId"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="BlogPostId"/>
                <span asp-validation-for="BlogPostId"></span>
            </div>
        </div>
        <div class="form-group" id="pnlCategory">
            <admin-label asp-for="CategoryId"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="CategoryId"/>
                <span asp-validation-for="CategoryId"></span>
            </div>
        </div>
        <div class="form-group" id="pnlCollection">
            <admin-label asp-for="CollectionId"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="CollectionId"/>
                <span asp-validation-for="CollectionId"></span>
            </div>
        </div>
        <div class="form-group" id="pnlBrand">
            <admin-label asp-for="BrandId"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="BrandId"/>
                <span asp-validation-for="BrandId"></span>
            </div>
        </div>

        <!-- Search parameters -->
        <div class="form-group" id="pnlSearchTerm">
            <admin-label asp-for="SearchTerm"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="SearchTerm"/>
                <span asp-validation-for="SearchTerm"></span>
                <span class="help-block">Enter a search term or keywords for the search page</span>
            </div>
        </div>

        <!-- Hidden fields for reference ID and parameters -->
        <input type="hidden" asp-for="ReferenceId" id="ReferenceId" />
        <input type="hidden" asp-for="ReferenceParameters" id="ReferenceParameters" />
        <div class="form-group">
            <admin-label asp-for="Published"/>
            <div class="col-md-9 col-sm-9">
                <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                    <admin-input asp-for="Published"/>
                    <div class="control__indicator"></div>
                </label>
                <span asp-validation-for="Published"></span>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="Stores"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="Stores"/>
                <span asp-validation-for="Stores"></span>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="FullWidth"/>
            <div class="col-md-9 col-sm-9">
                <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                    <admin-input asp-for="FullWidth"/>
                    <div class="control__indicator"></div>
                </label>
                <span asp-validation-for="FullWidth"></span>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="SliderTypeId"/>
            <div class="col-md-9 col-sm-9">
                <admin-select asp-for="SliderTypeId" asp-items="((SliderType)Model.SliderTypeId).ToSelectList()"/>
                <span asp-validation-for="SliderTypeId"></span>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="DisplayOrder"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="DisplayOrder"/>
                <span asp-validation-for="DisplayOrder"></span>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="StartDateUtc"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="StartDateUtc"/>
            </div>
        </div>
        <div class="form-group">
            <admin-label asp-for="EndDateUtc"/>
            <div class="col-md-9 col-sm-9">
                <admin-input asp-for="EndDateUtc"/>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Initialize the link selector
        SliderLinkSelector.init({
            linkTypeSelector: '#@Html.IdFor(model => model.LinkType)',
            manualLinkPanel: '#pnlManualLink',
            categorySelector: '#@Html.IdFor(model => model.CategoryId)',
            productSelector: '#@Html.IdFor(model => model.ProductId)',
            brandSelector: '#@Html.IdFor(model => model.BrandId)',
            collectionSelector: '#@Html.IdFor(model => model.CollectionId)',
            blogPostSelector: '#@Html.IdFor(model => model.BlogPostId)',
            searchTermInput: '#@Html.IdFor(model => model.SearchTerm)',
            referenceIdInput: '#ReferenceId',
            referenceParamsInput: '#ReferenceParameters'
        });
    });
</script>