@model LegalTextMessageTemplateModel
@{
    //page title
    ViewBag.Title = Loc["LegalTexts.Plugin.LegalTextMessageTemplate.EditMessageTemplateDetails"];
}
<form asp-area="Admin" asp-controller="ContractManagement" asp-action="Edit" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-envelope-o"></i>
                        @Loc["LegalTexts.Plugin.LegalTextMessageTemplate.EditMessageTemplateDetails"] - @Model.Name
                        <small>
                            <i class="fa fa-arrow-circle-left"></i>@Html.ActionLink(Loc["LegalTexts.Plugin.LegalTextMessageTemplate.BackToList"], "List")
                        </small>
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="fa fa-check"></i> @Loc["Admin.Common.Save"]
                            </button>
                            <button class="btn btn-success" type="submit" name="save-continue">
                                <i class="fa fa-check-circle"></i> @Loc["Admin.Common.SaveContinue"]
                            </button>
                            <a href="(@Url.Action("Delete", "ContractManagement", new { id = Model.Id }))" class="btn red">
                                <span id="message-template-delete" class="btn red">
                                <i class="fa fa-trash-o"></i> @Loc["Admin.Common.Delete"]
                            </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <partial name="Partials/CreateOrUpdate" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</form>