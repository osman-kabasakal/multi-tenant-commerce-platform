@model ConfigureViewModel


<form method="post" id="widget-settings-form" asp-action="Configure" asp-controller="TrendyolIntegration" asp-area="Admin">
    <div class="panel-group">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="form-body">
                    <div class="form-group">
                        <div class="col-md-3 col-sm-3 text-right">
                            <admin-label asp-for="SaticiId" class="control-label"/>
                        </div>
                        <div class="col-md-9 col-sm-9">
                            <admin-input asp-for="SaticiId"/>
                            <span asp-validation-for="SaticiId"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <admin-label asp-for="ApiKey"/>
                        <div class="col-md-9 col-sm-9">
                            <admin-input asp-for="ApiKey"/>
                            <span asp-validation-for="ApiKey"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <admin-label asp-for="ApiSecret"/>
                        <div class="col-md-9 col-sm-9">
                            <admin-input asp-for="ApiSecret"/>
                            <span asp-validation-for="ApiSecret"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <admin-label asp-for="StoreId"/>
                        <div class="col-md-9 col-sm-9">
                            <admin-select asp-items="Model.TrendyolRestaurant" asp-for="StoreId"></admin-select>
                            <span asp-validation-for="StoreId"></span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <admin-label asp-for="BestSellerSectionId"/>
                        <div class="col-md-9 col-sm-9">
                            <admin-select asp-items="Model.TrendyolSections" asp-for="BestSellerSectionId"></admin-select>
                            <span asp-validation-for="BestSellerSectionId"></span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <admin-label asp-for="NewSectionId"/>
                        <div class="col-md-9 col-sm-9">
                            <admin-select asp-items="Model.TrendyolSections" asp-for="NewSectionId"></admin-select>
                            <span asp-validation-for="NewSectionId"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="submit" id="savegeneralsettings" class="btn default" value="@Loc["Admin.Common.Save"]"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>