@model Famizyo.Simpra.Areas.Admin.Models.ConfigureViewModel

@{
    Layout="_ConfigurePlugin";
}

<div class="row">
    <div class="col-md-12">
        <div class="alert alert-info">
            <h4>Simple Configure Test</h4>
            <p>Model AccessToken: @(Model.AccessToken ?? "NULL")</p>
            <p>EnvironmentOptions count: @(Model.EnvironmentOptions?.Count ?? 0)</p>
        </div>
        
        <form method="post" asp-action="Configure" asp-controller="Simpra" asp-area="Admin">
            <div class="form-group">
                <label asp-for="AccessToken">Access Token</label>
                <input asp-for="AccessToken" class="form-control" type="password" />
                <span asp-validation-for="AccessToken"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="SimpraEnvironment">Environment</label>
                <select asp-for="SimpraEnvironment" asp-items="Model.EnvironmentOptions" class="form-control"></select>
                <span asp-validation-for="SimpraEnvironment"></span>
            </div>
            
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </form>
    </div>
</div>