{"SystemName":"OrderPlaced.VendorNotification","Title":"{{Store.Name}}. Yeni Sipari\u015F Bildirimi","Content":"\u003Cdiv style=\u0027font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #eaeaea; border-radius: 5px; padding: 20px;\u0027\u003E\u003Cdiv style=\u0027text-align: center; padding-bottom: 20px; border-bottom: 2px solid #f0f0f0;\u0027\u003E\u003Ca href=\u0027{{Store.URL}}\u0027 style=\u0027text-decoration: none; color: #333; font-size: 24px; font-weight: bold;\u0027\u003E{{Store.Name}}\u003C/a\u003E\u003C/div\u003E\u003Cdiv style=\u0027padding: 20px 0;\u0027\u003E\u003Cp style=\u0027font-size: 16px; line-height: 1.5; color: #333;\u0027\u003ESay\u0131n Sat\u0131c\u0131,\u003C/p\u003E\u003Cp style=\u0027font-size: 16px; line-height: 1.5; color: #333;\u0027\u003E{{Customer.FullName}} ({{Customer.Email}}) az \u00F6nce bir sipari\u015F verdi.\u003C/p\u003E\u003Cdiv style=\u0027background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin: 20px 0;\u0027\u003E\u003Cp style=\u0027margin: 5px 0; font-size: 16px;\u0027\u003E\u003Cstrong\u003ESipari\u015F Numaras\u0131:\u003C/strong\u003E {{Order.OrderNumber}}\u003C/p\u003E\u003Cp style=\u0027margin: 5px 0; font-size: 16px;\u0027\u003E\u003Cstrong\u003ESipari\u015F Tarihi:\u003C/strong\u003E {{Order.CreatedOn}}\u003C/p\u003E\u003C/div\u003E\u003Ctable style=\u0027width: 100%; border-collapse: collapse; margin-top: 20px;\u0027\u003E\u003Ctr style=\u0027background-color: #4a4f55; color: #ffffff; text-align: center;\u0027\u003E\u003Cth style=\u0027padding: 12px 8px; border: 1px solid #ddd;\u0027\u003E\u00DCr\u00FCn Ad\u0131\u003C/th\u003E\u003Cth style=\u0027padding: 12px 8px; border: 1px solid #ddd;\u0027\u003EFiyat\u003C/th\u003E\u003Cth style=\u0027padding: 12px 8px; border: 1px solid #ddd;\u0027\u003EMiktar\u003C/th\u003E\u003Cth style=\u0027padding: 12px 8px; border: 1px solid #ddd;\u0027\u003EToplam\u003C/th\u003E\u003C/tr\u003E{% for item in Order.OrderItems -%}\u003Ctr style=\u0027background-color: #f8f9fa; text-align: center;\u0027\u003E\u003Ctd style=\u0027padding: 10px 8px; text-align: left; border: 1px solid #ddd;\u0027\u003E{{item.ProductName}}{% if item.IsDownloadAllowed -%}\u003Cbr /\u003E\u003Ca class=\u0027link\u0027 href=\u0027{{item.DownloadUrl}}\u0027 style=\u0027color: #3498db; text-decoration: underline;\u0027\u003E\u0130ndir\u003C/a\u003E{% endif %}{% if item.IsLicenseDownloadAllowed -%}\u003Cbr /\u003E\u003Ca class=\u0027link\u0027 href=\u0027{{item.LicenseUrl}}\u0027 style=\u0027color: #3498db; text-decoration: underline;\u0027\u003ELisans\u0131 \u0130ndir\u003C/a\u003E{% endif %}{% if item.AttributeDescription != null and item.AttributeDescription != \u0027\u0027 %}\u003Cbr /\u003E{{item.AttributeDescription}}{% endif %}{% if item.ProductSku != null and item.ProductSku != \u0027\u0027 %}\u003Cbr /\u003EStok Kodu: {{item.ProductSku}}{% endif %}\u003C/td\u003E\u003Ctd style=\u0027padding: 10px 8px; text-align: right; border: 1px solid #ddd;\u0027\u003E{{item.UnitPrice}}\u003C/td\u003E\u003Ctd style=\u0027padding: 10px 8px; text-align: center; border: 1px solid #ddd;\u0027\u003E{{item.Quantity}}\u003C/td\u003E\u003Ctd style=\u0027padding: 10px 8px; text-align: right; border: 1px solid #ddd;\u0027\u003E{{item.TotalPrice}}\u003C/td\u003E\u003C/tr\u003E{% endfor -%}{% if Order.CheckoutAttributeDescription != null and Order.CheckoutAttributeDescription != \u0027\u0027 %}\u003Ctr\u003E\u003Ctd style=\u0027text-align:right; border: 1px solid #ddd;\u0027 colspan=\u00271\u0027\u003E\u0026nbsp;\u003C/td\u003E\u003Ctd colspan=\u00273\u0027 style=\u0027text-align:right; border: 1px solid #ddd; padding: 10px;\u0027\u003E{{Order.CheckoutAttributeDescription}}\u003C/td\u003E\u003C/tr\u003E{% endif %}\u003C/table\u003E\u003Cp style=\u0027font-size: 16px; line-height: 1.5; color: #333; margin-top: 20px;\u0027\u003ESipari\u015Fi i\u015Fleme alman\u0131z ve en k\u0131sa s\u00FCrede haz\u0131rlaman\u0131z gerekmektedir.\u003C/p\u003E\u003Cp style=\u0027font-size: 16px; line-height: 1.5; color: #333;\u0027\u003ESipari\u015Fle ilgili herhangi bir sorunuz varsa l\u00FCtfen destek ekibimizle ileti\u015Fime ge\u00E7iniz.\u003C/p\u003E\u003C/div\u003E\u003Cdiv style=\u0027padding-top: 20px; border-top: 2px solid #f0f0f0; text-align: center; font-size: 14px; color: #777;\u0027\u003E\u003Cp\u003EBu e-posta {{Store.Name}} taraf\u0131ndan otomatik olarak g\u00F6nderilmi\u015Ftir.\u003C/p\u003E\u003Cp\u003E\u00A9 {{Store.CompanyName}} - T\u00FCm Haklar\u0131 Sakl\u0131d\u0131r.\u003C/p\u003E\u003C/div\u003E\u003C/div\u003E","LiquidTokens":null}