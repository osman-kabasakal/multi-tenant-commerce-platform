if %}\\n      \\n      {% if Order.DisplayPaymentMethodFee %}\\n      \u003Ctr\u003E\\n        \u003Ctd\u003E\u0026nbsp;\u003C/td\u003E\\n        \u003Ctd colspan=\u00222\u0022 style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003E\u00D6deme Y\u00F6ntemi Ek \u00DCcreti:\u003C/td\u003E\\n        \u003Ctd style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003E{{Order.PaymentMethodAdditionalFee}}\u003C/td\u003E\\n      \u003C/tr\u003E\\n      {% endif %}\\n      \\n      {% if Order.DisplayTax %}\\n      \u003Ctr\u003E\\n        \u003Ctd\u003E\u0026nbsp;\u003C/td\u003E\\n        \u003Ctd colspan=\u00222\u0022 style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003EVergi:\u003C/td\u003E\\n        \u003Ctd style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003E{{Order.Tax}}\u003C/td\u003E\\n      \u003C/tr\u003E\\n      {% endif %}\\n      \\n      {% if Order.DisplayTaxRates %}\\n      {% for item in Order.TaxRates -%}\\n      \u003Ctr\u003E\\n        \u003Ctd\u003E\u0026nbsp;\u003C/td\u003E\\n        \u003Ctd colspan=\u00222\u0022 style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003E{{item.Key}}\u003C/td\u003E\\n        \u003Ctd style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003E{{item.Value}}\u003C/td\u003E\\n      \u003C/tr\u003E\\n      {% endfor -%}\\n      {% endif %}\\n      \\n      {% if Order.DisplayDiscount %}\\n      \u003Ctr\u003E\\n        \u003Ctd\u003E\u0026nbsp;\u003C/td\u003E\\n        \u003Ctd colspan=\u00222\u0022 style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u003E\u0130ndirim:\u003C/td\u003E\\n        \u003Ctd style=\u0022background-color: #f5f5f5; padding: 10px; text-align: right; font-weight: bold;\u0022\u00