<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Business\Grand.Business.Core\Grand.Business.Core.csproj" />
        <ProjectReference Include="..\..\Core\Grand.Domain\Grand.Domain.csproj" />
        <ProjectReference Include="..\..\Core\Grand.Infrastructure\Grand.Infrastructure.csproj" />
        <ProjectReference Include="..\..\Core\Grand.SharedKernel\Grand.SharedKernel.csproj" />
        <ProjectReference Include="..\..\API\Grand.Api\Grand.Api.csproj" />
        <ProjectReference Include="..\..\Web\Grand.Web.Common\Grand.Web.Common.csproj" />
        <ProjectReference Include="..\..\Web\Grand.Web.ExternalSettings\Grand.Web.ExternalSettings.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.multitenant.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Views\PdfTemplates\OrderPdfTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Views\PdfTemplates\ShipmentPdfTemplate.cshtml">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <Content Include="App_Data\**" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" Exclude="App_Data\DataProtectionKeys\*.xml;" />
        <Content Include="Roslyn\**" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" Exclude="Roslyn\**\*.dll" />
        <Content Include="wwwroot\**" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" Exclude="wwwroot\assets\images\thumbs\*.jpeg;wwwroot\assets\images\thumbs\*.jpg;wwwroot\assets\images\thumbs\*.png" />

    </ItemGroup>
    <Target Name="PublishViews" BeforeTargets="PrepareForPublish">
        <ItemGroup>
            <PluginFiles Include="Plugins/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PublishDir)/Plugins/%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
    <!--<PropertyGroup>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
      </PropertyGroup>-->
    <ItemGroup>
        <Content Remove="Plugins\**" />
        <Compile Remove="Plugins\**" />
        <EmbeddedResource Remove="Plugins\**" />
        <None Remove="Plugins\**" />
        <Content Update="Plugins\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <None Update="appsettings.multitenant.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="App_Data\Development\" />
    </ItemGroup>

</Project>
