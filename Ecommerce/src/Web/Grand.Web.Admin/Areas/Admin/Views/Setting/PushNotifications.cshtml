@model PushNotificationsSettingsModel
@{
    //page title
    ViewBag.Title = Loc["Admin.PushNotifications"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="PushNotifications" method="post" enctype="multipart/form-data">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-cubes"></i>
                        @Loc["Admin.PushNotifications"]
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="fa fa-check"></i> @Loc["Admin.Common.Save"]
                            </button>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <div class="form-horizontal">
                        <div class="form-body">
                            <div class="alert alert-info">
                                <p>@Loc["Admin.Settings.PushNotifications.PushNotifications.Info"]</p>
                            </div>
                            <div class="alert alert-danger">
                                <p>@Loc["Admin.Settings.PushNotifications.PushNotifications.Warning"]</p>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="Enabled"/>
                                <div class="col-md-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <admin-input asp-for="Enabled"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="PrivateApiKey"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="PrivateApiKey"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="PushApiKey"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="PushApiKey"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="AuthDomain"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="AuthDomain"/>
                                </div>
                            </div>
                            @*<div class="form-group">
                                <admin-label asp-for="DatabaseUrl" />
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="DatabaseUrl" />
                                </div>
                            </div>*@
                            <div class="form-group">
                                <admin-label asp-for="ProjectId"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="ProjectId"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="StorageBucket"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="StorageBucket"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="SenderId"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="SenderId"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="AppId"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="AppId"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="AllowGuestNotifications"/>
                                <div class="col-md-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <admin-input asp-for="AllowGuestNotifications"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <admin-label asp-for="UseHttpV1Api"/>
                                <div class="col-md-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <admin-input asp-for="UseHttpV1Api"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                    <span class="help-block">@Loc["Admin.Settings.PushNotifications.UseHttpV1Api.Hint"]</span>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <admin-label asp-for="ServiceAccountFile"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="ServiceAccountFile" />
                                    <span class="help-block">@Loc["Admin.Settings.PushNotifications.ServiceAccountFile.Hint"]</span>
                                    @if (Model.HasServiceAccountConfigured)
                                    {
                                        <div class="alert alert-success mt-2">
                                            <i class="fa fa-check"></i>
                                            @Loc["Admin.Settings.PushNotifications.ServiceAccountFile.Configured"]
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>