@model PushNotificationsSettingsModel
@{
    //page title
    ViewBag.Title = Loc["Admin.PushNotifications"];
}
<form asp-area="@Constants.AreaAdmin" asp-controller="Setting" asp-action="PushNotifications" method="post">

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel light form-fit">
                <div class="x_title">
                    <div class="caption">
                        <i class="fa fa-cubes"></i>
                        @Loc["Admin.PushNotifications"]
                    </div>
                    <div class="actions">
                        <div class="btn-group btn-group-devided">
                            <button class="btn btn-success" type="submit" name="save">
                                <i class="fa fa-check"></i> @Loc["Admin.Common.Save"]
                            </button>
                        </div>
                    </div>
                </div>
                <div class="x_content form">
                    <div class="form-horizontal">
                        <div class="form-body">
                            @if (Model.MobileProvider != "Disabled")
                            {
                                <div class="alert alert-success">
                                    <p>Mobil uygulama bildirim sağlayıcısı sunucuda yapılandırıldı: @(Model.MobileProvider == "FcmApns" ? "Android ve iOS" : Model.MobileProvider == "Fcm" ? "Firebase" : "Yerel demo").</p>
                                    <p>Bildirim izni veren alıcı sayısı: @Model.MobileReceivers. Cihazda izin verildiğinde alıcı kaydı otomatik eklenir.</p>
                                    <a asp-area="@Constants.AreaAdmin" asp-controller="PushNotifications" asp-action="Send">Bildirim gönder</a>
                                    · <a asp-area="@Constants.AreaAdmin" asp-controller="PushNotifications" asp-action="Receivers">Alıcıları görüntüle</a>
                                </div>
                            }
                            <p>Alttaki Firebase tarayıcı ayarları, web bildirimleri içindir. Mobil bildirimler sunucudaki sağlayıcıyı kullanır; buraya özel anahtar yüklenmez.</p>
                            <div class="alert alert-info">
                                <p>@Loc["Admin.Settings.PushNotifications.PushNotifications.Info"]</p>
                                <p>@Loc["Admin.Settings.PushNotifications.ServerIdentityInfo"]</p>
                            </div>
                            <div class="alert alert-danger">
                                <p>@Loc["Admin.Settings.PushNotifications.PushNotifications.Warning"]</p>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="Enabled"/>
                                <div class="col-md-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <admin-input asp-for="Enabled"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="PushApiKey"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="PushApiKey"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="AuthDomain"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="AuthDomain"/>
                                </div>
                            </div>
                            @*<div class="form-group">
                                <admin-label asp-for="DatabaseUrl" />
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="DatabaseUrl" />
                                </div>
                            </div>*@
                            <div class="form-group">
                                <admin-label asp-for="ProjectId"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="ProjectId"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="StorageBucket"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="StorageBucket"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="SenderId"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="SenderId"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="AppId"/>
                                <div class="col-md-9 col-sm-9">
                                    <admin-input asp-for="AppId"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <admin-label asp-for="AllowGuestNotifications"/>
                                <div class="col-md-9">
                                    <label class="mt-checkbox mt-checkbox-outline control control-checkbox">
                                        <admin-input asp-for="AllowGuestNotifications"/>
                                        <div class="control__indicator"></div>
                                    </label>
                                </div>
                            </div>
                            
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>